{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/auto-commit.ps1",
            "timeout": 60,
            "statusMessage": "Auto-commit & push to GitHub"
          }
        ]
      }
    ]
  }
}
